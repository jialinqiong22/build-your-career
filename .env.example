# Server-only. Configure separately in Vercel and the local issuer environment.
# Use a cryptographically random secret of at least 32 UTF-8 bytes. Never use NEXT_PUBLIC_.
PREMIUM_ACCESS_SECRET=
# Comma-separated non-personal order identifiers. Redeploy/restart after changing.
PREMIUM_REVOKED_ORDERS=
# Optional legacy order -> authenticated user ID mapping. New codes bind their recipient directly.
PREMIUM_LEGACY_ORDER_OWNERS={}
# Enable only after social migration and retention/deletion policy are approved.
SOCIAL_ENABLED=false
# Public-facing contact text for manual WeChat/Alipay confirmation and consultation.
PREMIUM_CONTACT=

# Separate account database for this app. Do not reuse another app's global DATABASE_URL.
# Pooled Neon URL for application traffic; direct URL for migrations.
CAREER_DATABASE_URL=
CAREER_DATABASE_URL_UNPOOLED=
# Random server-only secret, at least 32 bytes. Rotating invalidates account sessions.
AUTH_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Enable only after applying the users/session/rate-limit migration.
AUTH_ENABLED=false

# Welcome and verification-code email. RESEND_FROM_EMAIL must belong to a domain
# verified in Resend. Registration, password reset and the welcome message share it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional testing override: redirects ALL mail (welcome + verification codes) to
# this address. Remove after the sending domain is verified.
RESEND_TEST_TO_EMAIL=
SUPPORT_EMAIL=
NEXT_PUBLIC_APP_URL=

# Public Crisp website identifier used by the browser chat widget.
NEXT_PUBLIC_CRISP_WEBSITE_ID=
